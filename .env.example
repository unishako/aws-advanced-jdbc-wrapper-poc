# docker compose とアプリが使う環境変数の一覧。
# 変更したい場合は、このファイルを .env にコピーして値を書き換える (.env は Git の管理対象外)。
# 未設定の場合は、ここに書かれた既定値(ローカル検証用)が使われる。
#
# 注意: DB の接続情報は、docker/postgres/ にデータができる初回起動時に決まる。
#       変更後に反映するには scripts/reset-db.sh で DB を作り直す(データは削除される)。

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
REPLICATION_PASSWORD=replicator

# ホスト側のポート (127.0.0.1 のみで待ち受ける)
WRITER_PORT=5432
READER_PORT=5433
APP_PORT=8080
